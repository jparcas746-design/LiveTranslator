# Core database (required in production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"

# Public canonical URL for metadata, sitemap and robots (recommended in production)
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Admin authentication (required in production)
ADMIN_PASSWORD="replace-with-strong-admin-password"
THOR_ADMIN_SESSION_SECRET="replace-with-long-random-secret"

# Optional backward-compat admin variables
THOR_ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""
THOR_ADMIN_KEY=""

# Knowledge engine database override (optional)
THOR_KNOWLEDGE_DB_DSN=""

# Knowledge source storage path (required if using local file storage in self-hosted deployments)
THOR_KNOWLEDGE_STORAGE_DIR=""

# Required only on Vercel for persistent blob file storage of uploaded knowledge docs
BLOB_READ_WRITE_TOKEN=""

# Embeddings provider configuration (optional)
THOR_EMBEDDINGS_PROVIDER="hash"
THOR_EMBED_DIM="768"
THOR_OLLAMA_URL="http://127.0.0.1:11434"
THOR_OLLAMA_EMBED_MODEL="nomic-embed-text"

# Optional AI providers (only required if those features are enabled)
GROQ_API_KEY=""
GEMINI_API_KEY=""
TAVILY_API_KEY=""
